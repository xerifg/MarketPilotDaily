    "database_name": "market-pilot-daily",
    "database_id": "fc055619-02a8-4352-8bad-2550d581ae62",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGIN": "https://market-pilot-daily.market-pilot-daily.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23li27aW861SnCB0It",
    "GITHUB_OWNER_ID": "24712937"
  },
  "observability": { "enabled": false }
}
