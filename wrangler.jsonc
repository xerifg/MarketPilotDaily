{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-pilot-daily",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
